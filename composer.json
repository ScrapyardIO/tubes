{
    "name": "scrapyard-io/tubes",
    "description": "The ScrapyardIO Display Panel Framework.",
    "keywords": ["framework", "scrapyard-io"],
    "license": "MIT",
    "version": "0.6.0",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com",
    "support": {
        "issues": "https://github.com/scrapyard-io/gpio-framework/issues",
        "source": "https://github.com/scrapyard-io/gpio-framework"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "fabricate/displays": "^0.6.0",
        "fabricate/circuits": "^0.6.0"
    },
    "replace": {
        "tubes/monochrome": "self.version",
        "tubes/color": "self.version",
        "tubes/matrix": "self.version",
        "tubes/epaper": "self.version"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "files": [],
        "psr-4": {
            "ScrapyardIO\\Tubes\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.6-dev"
        },
        "scrapyard-io": {
            "providers": [
                "ScrapyardIO\\Tubes\\Core\\Providers\\TubesServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
